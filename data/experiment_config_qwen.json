{
  "train_model": "Qwen/Qwen3.5-9B",
  "n_samples": 50000,
  "micro_batch_size": 16,
  "micro_batch_size_overrides": {
    "abstracts_only": 32
  },
  "eval_batch_size": 32,
  "inference_batch_size": 64,
  "max_response_tokens": 300,
  "use_gradient_checkpointing": false,
  "optim": "adamw_torch",
  "chat_template_kwargs": {"enable_thinking": false},
  "save_resume_checkpoints": true,
  "dataloader_num_workers": 2,
  "profile": "qwen",
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "in_proj_qkv",
    "in_proj_z",
    "in_proj_a",
    "in_proj_b",
    "out_proj"
  ]
}
